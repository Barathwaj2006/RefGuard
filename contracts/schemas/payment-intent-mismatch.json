{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaymentIntentMismatch",
  "description": "Analysis comparing stated intent against actual payment mechanism action",
  "type": "object",
  "properties": {
    "status": { "type": "string", "enum": ["DETECTED", "NOT_DETECTED", "UNKNOWN", "NOT_OBSERVED"] },
    "stated_intent": { "type": "string" },
    "actual_payment_action": { "type": "string" },
    "payment_direction": { "type": "string", "enum": ["OUTBOUND_DEBIT", "INBOUND_CREDIT", "NONE", "UNKNOWN"] },
    "amount": { "type": "number" },
    "recipient_vpa": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
    "provenance": { "type": "string" },
    "evidence": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["status", "payment_direction", "confidence", "provenance"],
  "additionalProperties": false
}
