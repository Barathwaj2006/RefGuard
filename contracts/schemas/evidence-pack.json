{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EvidencePack",
  "description": "Incident documentation without retaining sensitive credentials",
  "type": "object",
  "properties": {
    "incident_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "original_content_hash": { "type": "string" },
    "extracted_entities": { "type": "array", "items": { "type": "string" } },
    "urls": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "upi_identifiers": { "type": "array", "items": { "type": "string" } },
    "risk_signals": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["incident_id", "timestamp"],
  "additionalProperties": false
}
