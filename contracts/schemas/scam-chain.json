{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScamChain",
  "description": "Directed sequence graph mapping scam relationships. Nodes represent contextual classifications based on ExtractionResult, TI, Risk, and Context Engine derivations.",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": { "type": "string" },
          "node_type": { "type": "string", "enum": ["MESSAGE", "REFERRAL", "SHORT_LINK", "REDIRECT", "LANDING_PAGE", "UPI_REQUEST", "PAYMENT_ACTION"], "description": "Contextual classification, NOT necessarily identical to ExtractionResult entity_type" },
          "entity_reference": { "type": "string" },
          "evidence_references": { "type": "array", "items": { "type": "string" }, "description": "References resolving to EvidencePack.items[].evidence_id" }
        },
        "required": ["node_id", "node_type"]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_node": { "type": "string" },
          "to_node": { "type": "string" },
          "relationship": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
          "provenance": { "type": "string" },
          "evidence_references": { "type": "array", "items": { "type": "string" }, "description": "References resolving to EvidencePack.items[].evidence_id" }
        },
        "required": ["from_node", "to_node", "relationship", "confidence", "provenance"]
      }
    }
  },
  "required": ["nodes", "edges"],
  "additionalProperties": false
}
