{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ThreatAssessment",
  "description": "Threat intelligence assessment of a specific indicator",
  "type": "object",
  "properties": {
    "indicator_type": { "type": "string", "enum": ["URL", "DOMAIN", "UPI_VPA", "PHONE", "REFERRAL_CODE"] },
    "indicator_value": { "type": "string" },
    "classification": { "type": "string", "enum": ["SAFE", "SUSPICIOUS", "MALICIOUS", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
    "source": { "type": "string" },
    "source_type": { "type": "string", "enum": ["PUBLIC", "CURATED", "COMMUNITY", "LOCAL_RULE", "THIRD_PARTY"] },
    "freshness_timestamp": { "type": "string", "format": "date-time" },
    "provenance": { "type": "string" }
  },
  "required": ["indicator_type", "indicator_value", "classification", "confidence", "source", "source_type", "freshness_timestamp", "provenance"],
  "additionalProperties": false
}
