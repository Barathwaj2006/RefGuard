{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractionResult",
  "description": "Represents entities extracted or inferred from the scan request",
  "type": "object",
  "properties": {
    "extracted_entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/Entity" }
    },
    "inferred_entities": {
      "type": "array",
      "items": { "$ref": "#/definitions/Entity" }
    }
  },
  "required": ["extracted_entities", "inferred_entities"],
  "definitions": {
    "Entity": {
      "type": "object",
      "properties": {
        "entity_type": { "type": "string", "enum": ["URL", "DOMAIN", "UPI_VPA", "QR_DATA", "PHONE", "AMOUNT", "BRAND", "REFERRAL_CODE", "TEXT", "PAYMENT_DIRECTION"] },
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
        "provenance": { "type": "string" }
      },
      "required": ["entity_type", "value", "confidence", "provenance"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
