{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtectionDecision",
  "description": "Advisory protection action for the user interface",
  "type": "object",
  "properties": {
    "action": { "type": "string", "enum": ["ALLOW", "WARN_CAUTION", "REQUIRE_CONFIRMATION", "DISCOURAGE_PROCEED"] },
    "detected_summary": { "type": "string" },
    "why_it_matters": { "type": "string" },
    "user_instruction": { "type": "string" }
  },
  "required": ["action", "detected_summary", "why_it_matters", "user_instruction"],
  "additionalProperties": false
}
