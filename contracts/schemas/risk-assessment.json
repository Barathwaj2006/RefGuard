{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RiskAssessment",
  "description": "Composite risk score and explainable assessment details",
  "type": "object",
  "properties": {
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "risk_severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
    "signals": { "type": "array", "items": { "type": "string" } },
    "evidence_references": { "type": "array", "items": { "type": "string" } },
    "human_explanation": { "type": "string" },
    "recommended_action": { "type": "string" }
  },
  "required": ["risk_score", "risk_severity", "confidence", "signals", "human_explanation", "recommended_action"],
  "additionalProperties": false
}
