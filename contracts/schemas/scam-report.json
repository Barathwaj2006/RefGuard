{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScamReport",
  "description": "Community reporting signal",
  "type": "object",
  "properties": {
    "report_id": { "type": "string" },
    "reported_indicator": { "type": "string" },
    "report_category": { "type": "string" },
    "description": { "type": "string" },
    "evidence_references": { "type": "array", "items": { "type": "string" }, "description": "References resolving to EvidencePack.items[].evidence_id" },
    "submission_timestamp": { "type": "string", "format": "date-time" },
    "moderation_status": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
    "provenance": { "type": "string" }
  },
  "required": ["report_id", "reported_indicator", "report_category", "submission_timestamp", "moderation_status", "confidence", "provenance"],
  "additionalProperties": false
}
